# 1. Setup environment variables
RG="demo-aca-rg"
LOC="eastus2"
ENV_NAME="demo-aca-env"
APP_NAME="demo-web-app"
IMAGE="mcr.microsoft.com/k8se/quickstart:latest"

# Define the new public web app image
NEW_IMAGE="nginxdemos/hello:latest"


# 2. Create a resource group
az group create --name $RG --location $LOC

# 3. Create the Container Apps Environment
az containerapp env create --name $ENV_NAME --resource-group $RG --location $LOC

# 4. Deploy the App with single-Revision mode and Replica settings
az containerapp create \
  --name $APP_NAME \
  --resource-group $RG \
  --environment $ENV_NAME \
  --image $IMAGE \
  --target-port 80 \
  --ingress external \
  --min-replicas 2 \
  --max-replicas 5

# Update the app with the new container image
az containerapp update \
  --name $APP_NAME \
  --resource-group $RG \
  --image $NEW_IMAGE

az containerapp revision list --name $APP_NAME --resource-group $RG --output table

az containerapp revision list \
  --name $APP_NAME \
  --resource-group $RG \
  --query "[?properties.active==\`true\`].{Name:name, TrafficWeight:properties.trafficWeight, Created:properties.createdTime}" \
  --output table

az containerapp replica list \
  --name $APP_NAME \
  --resource-group $RG \
  --revision demo-web-app--0000001 \
  --output table


# ===================================================================================

NEW_APP_NAME="demo-web-app-multilple"

az containerapp create \
  --name $NEW_APP_NAME \
  --resource-group $RG \
  --environment $ENV_NAME \
  --image $IMAGE \
  --target-port 80 \
  --ingress external \
  --min-replicas 2 \
  --max-replicas 5

echo " Starting Zero-Downtime Blue-Green Deployment..."

az containerapp revision set-mode \
  --name $NEW_APP_NAME \
  --resource-group $RG \
  --mode multiple

V1_REV=$(az containerapp revision list --name $NEW_APP_NAME --resource-group $RG \
  --query "[?properties.active==\`true\`].name" --output tsv)
echo $V1_REV

# EXPLICITLY PIN TRAFFIC to this revision name
# This breaks the "latest revision wins" link
az containerapp ingress traffic set \
  --name $NEW_APP_NAME \
  --resource-group $RG \
  --revision-weight "$V1_REV=100"

echo "Identifying current active revision..."
CURRENT_ACTIVE_REV=$(az containerapp show \
  --name $NEW_APP_NAME \
  --resource-group $RG \
  --query "properties.configuration.ingress.traffic[?weight==\`100\`].revisionName" \
  --output tsv)

if [ -z "$CURRENT_ACTIVE_REV" ]; then
    echo "Error: Could not find a revision with 100% traffic. Is traffic currently split?"
fi
echo "Current active production revision: $CURRENT_ACTIVE_REV"


echo "Deploying new image ($NEW_IMAGE)..."
az containerapp update \
  --name $NEW_APP_NAME \
  --resource-group $RG \
  --image $NEW_IMAGE

NEW_REV=$(az containerapp revision list \
  --name $NEW_APP_NAME \
  --resource-group $RG \
  --query "sort_by([].{name:name, created:properties.createdTime}, &created)[-1].name" \
  --output tsv)

echo $NEW_REV


# Fetch the unique, direct testing FQDN for this specific revision
REV_FQDN=$(az containerapp revision show \
  --name $NEW_APP_NAME \
  --resource-group $RG \
  --revision $NEW_REV \
  --query "properties.fqdn" \
  --output tsv)

echo "New Revision Created: $NEW_REV"
echo "Private Revision Test URL: https://$REV_FQDN"


echo "Beginning automated health checks on the new revision..."
MAX_ATTEMPTS=12
ATTEMPT=1
SUCCESS=false

while [ $ATTEMPT -le $MAX_ATTEMPTS ]; do
    echo "Health Check Attempt $ATTEMPT/$MAX_ATTEMPTS..."
    
    HTTP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" "https://$REV_FQDN" || echo "000")
    
    if [ "$HTTP_STATUS" -eq 200 ]; then
        echo "Health check PASSED! Revision returned HTTP 200."
        SUCCESS=true
        break
    else
        echo "Health check failed with status: $HTTP_STATUS. Retrying in 10 seconds..."
        sleep 10
        ATTEMPT=$((ATTEMPT + 1))
    fi
done

# If health checks fail, abort safely without modifying production traffic
if [ "$SUCCESS" = false ]; then
    echo "Error: New revision failed health checks. Aborting deployment."
    echo "Deactivating failed revision..."
    az containerapp revision deactivate --name $NEW_APP_NAME --resource-group $RG --revision $NEW_REV
    exit 1
fi

echo "Executing atomic production swap..."
echo "Shifting 100% traffic to $NEW_REV using ingress traffic command..."

# Using the dedicated ingress traffic set command [1]
az containerapp ingress traffic set \
  --name $NEW_APP_NAME \
  --resource-group $RG \
  --revision-weight "$NEW_REV=100"

echo "Deployment successfully swapped with ZERO downtime!"

echo $CURRENT_ACTIVE_REV
echo "Deactivating old revision ($CURRENT_ACTIVE_REV) to scale down to 0 replicas..."
az containerapp revision deactivate \
  --name $NEW_APP_NAME \
  --resource-group $RG \
  --revision $CURRENT_ACTIVE_REV

==========================================================================================
The underlying Envoy proxy routes traffic to the already-running 
replicas of the new revision in less than a millisecond. 
There are no dropped connections, no cold starts, and no server restarts.

