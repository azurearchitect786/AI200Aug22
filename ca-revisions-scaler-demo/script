# Now let us see canary release pattern

# ==========================================
# 1. ENVIRONMENT VARIABLES
# ==========================================
RG="canary-demo-rg"
LOC="eastus2"
ENV_NAME="canary-env"
APP_NAME="canary-web-app"

# App versions (using lightweight public web apps)
BASE_IMAGE="mcr.microsoft.com/k8se/quickstart:latest"
CANARY_IMAGE="nginxdemos/hello:latest"

az group create --name $RG --location $LOC
az containerapp env create --name $ENV_NAME --resource-group $RG --location $LOC

echo "Deploying base version (Production V1)..."
az containerapp create \
  --name $APP_NAME \
  --resource-group $RG \
  --environment $ENV_NAME \
  --image $BASE_IMAGE \
  --target-port 80 \
  --ingress external \
  --revisions-mode multiple \
  --min-replicas 2 \
  --max-replicas 5

V1_REV=$(az containerapp revision list --name $APP_NAME --resource-group $RG \
  --query "[?properties.active==\`true\`].name" --output tsv)
echo $V1_REV

# EXPLICITLY PIN TRAFFIC to this revision name
# This breaks the "latest revision wins" link
az containerapp ingress traffic set \
  --name $APP_NAME \
  --resource-group $RG \
  --revision-weight "$V1_REV=100"

echo "Production V1 is live on revision: $V1_REV"
echo "----------------------------------------------------------------"


echo "Phase 2: Starting Canary Release Pattern for V2..."
echo "Injecting Canary image ($CANARY_IMAGE)..."
az containerapp update \
--name $APP_NAME \
--resource-group $RG \
--image $CANARY_IMAGE

V2_CANARY_REV=$(az containerapp revision list --name $APP_NAME --resource-group $RG \
  --query "sort_by([].{name:name, created:properties.createdTime}, &created)[-1].name" --output tsv)
echo $V2_CANARY_REV

CANARY_FQDN=$(az containerapp revision show --name $APP_NAME --resource-group $RG \
  --revision $V2_CANARY_REV --query "properties.fqdn" --output tsv)


echo "Canary Revision created: $V2_CANARY_REV"
echo "Dedicated Canary internal test URL: https://$CANARY_FQDN"

# 5. Route 10% Traffic to the Canary
echo "Routing 10% of public production traffic to the Canary..."
az containerapp ingress traffic set --name $APP_NAME --resource-group $RG \
  --revision-weight "$V1_REV=90" "$V2_CANARY_REV=10"

# 6. Monitor Canary Health under live traffic
echo "Monitoring Canary health at 10% exposure..."
MAX_CHECKS=10
for i in $(seq 1 $MAX_CHECKS); do
    echo "Canary live traffic verification check $i/$MAX_CHECKS..."
    STATUS=$(curl -s -o /dev/null -w "%{http_code}" "https://$CANARY_FQDN" || echo "000")
    if [ "$STATUS" -eq 200 ]; then
        echo "Check passed (HTTP 200)"
        sleep 5
    else
        echo "Canary failed with status $STATUS! Initiating rollback..."
        az containerapp ingress traffic set --name $APP_NAME --resource-group $RG --revision-weight "$V1_REV=100"
        az containerapp revision deactivate --name $APP_NAME --resource-group $RG --revision $V2_CANARY_REV
        exit 1
    fi
done

echo "Canary stable. Increasing traffic share to 50%..."
az containerapp ingress traffic set --name $APP_NAME --resource-group $RG \
  --revision-weight "$V1_REV=50" "$V2_CANARY_REV=50"

# 8. Complete Full Promotion to 100% Traffic
echo "Canary completely successful! Promoting V2 to 100% production..."
az containerapp ingress traffic set --name $APP_NAME --resource-group $RG \
  --revision-weight "$V2_CANARY_REV=100"

# 9. Clean up V1 (Scale down to 0 replicas)
echo "Deactivating V1 revision ($V1_REV) to eliminate idle infrastructure costs..."
az containerapp revision deactivate --name $APP_NAME --resource-group $RG --revision $V1_REV

echo "Canary rollout completed with zero downtime!"

