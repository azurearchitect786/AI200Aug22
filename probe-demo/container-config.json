{
  "identity": {
    "type": "UserAssigned",
    "userAssignedIdentities": {
      "IDENTITY_ID_PLACEHOLDER": {}
    }
  },
  "properties": {
    "configuration": {
      "activeRevisionsMode": "Single",
      "ingress": {
        "external": true,
        "targetPort": 5000,
        "transport": "auto",
        "allowInsecure": false
      },
      "registries": [
        {
          "server": "ACR_NAME_PLACEHOLDER.azurecr.io",
          "identity": "IDENTITY_ID_PLACEHOLDER"
        }
      ]
    },
    "template": {
      "containers": [
        {
          "name": "probe-demo-app",
          "image": "ACR_NAME_PLACEHOLDER.azurecr.io/probe-demo:1.0.0",
          "resources": {
            "cpu": 0.5,
            "memory": "1.0Gi"
          },
          "probes": [
            {
              "type": "Startup",
              "httpGet": { "path": "/startup", "port": 5000 },
              "initialDelaySeconds": 5,
              "periodSeconds": 3,
              "failureThreshold": 10
            },
            {
              "type": "Liveness",
              "httpGet": { "path": "/liveness", "port": 5000 },
              "periodSeconds": 5,
              "initialDelaySeconds": 2,
              "failureThreshold": 2
            },
            {
              "type": "Readiness",
              "httpGet": { "path": "/readiness", "port": 5000 },
              "periodSeconds": 3,
              "timeoutSeconds": 2,
              "failureThreshold": 2
            }
          ]
        }
      ],
      "scale": {
        "minReplicas": 1,
        "maxReplicas": 1
      }
    }
  }
}
