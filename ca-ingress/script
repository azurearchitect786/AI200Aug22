RG="ingress-demo-rg"
LOC="eastus2"
ENV_NAME="ingress-demo-env"

az group create --name $RG --location $LOC
az containerapp env create --name $ENV_NAME --resource-group $RG --location $LOC

HTTP_APP="http-affinity-app"

az containerapp create \
  --name $HTTP_APP \
  --resource-group $RG \
  --environment $ENV_NAME \
  --image "nginxdemos/hello:plain-text" \
  --target-port 80 \
  --ingress external \
  --min-replicas 3 \
  --max-replicas 3

HTTP_URL=$(az containerapp show -n $HTTP_APP -g $RG --query "properties.configuration.ingress.fqdn" -o tsv)

echo "HTTP Ingress URL: https://$HTTP_URL"

echo "Activating Layer 7 Session Affinity..."
az containerapp ingress sticky-sessions set \
  --name $HTTP_APP \
  --resource-group $RG \
  --affinity sticky

